    //arms and hands
    glColor3f(0.02f, 0.02f, 0.02f);
    glBegin(GL_QUADS); glVertex2f(0.20f, -0.40f); glVertex2f(0.27f, -0.50f); glVertex2f(0.28, -0.60f); glVertex2f(0.18, -0.45f); glEnd(); //right arm
    glBegin(GL_QUADS); glVertex2f(-0.20f, -0.40f); glVertex2f(-0.27f, -0.50f); glVertex2f(-0.28, -0.60f); glVertex2f(-0.18, -0.45f); glEnd(); //left arm

    glColor3f(0.96f, 0.78f, 0.62f);
    glBegin(GL_QUADS); glVertex2f(0.26f, -0.57f); glVertex2f(0.31f, -0.58f); glVertex2f(0.30f, -0.64f); glVertex2f(0.25f, -0.63f); glEnd(); //right hand
    glBegin(GL_QUADS); glVertex2f(-0.26f, -0.57f); glVertex2f(-0.31f, -0.58f); glVertex2f(-0.30f, -0.64f); glVertex2f(-0.25f, -0.63f); glEnd(); //left hand

    glPopMatrix();

    //Daughter
    glPushMatrix();
