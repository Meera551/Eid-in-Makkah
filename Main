    glPopMatrix();

    //Text
    drawText("Rafef: Mama... why is everyone so happy?", -0.9f, 0.9f);
    drawText("Sarah: Because Eid here is not just about sweets...", -0.9f, 0.83f);
    drawText("It is about hearts that love each other.", -0.9f, 0.76f);
