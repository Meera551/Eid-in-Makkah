    glColor3f(1.0f, 0.5f, 0.7f); glBegin(GL_TRIANGLES); glVertex2f(0.0f, -0.26f); glVertex2f(0.3f, -0.75f); glVertex2f(-0.3f, -0.75f); glEnd(); // dress
    glColor3f(1.0f, 0.8f, 0.6f);
    glBegin(GL_QUADS); glVertex2f(0.07f, -0.35f); glVertex2f(0.5f, -0.55f); glVertex2f(0.45f, -0.6f); glVertex2f(0.1f, -0.4f); glEnd(); // hands
    glBegin(GL_QUADS); glVertex2f(-0.07f, -0.35f); glVertex2f(-0.5f, -0.55f); glVertex2f(-0.45f, -0.6f); glVertex2f(-0.1f, -0.4f); glEnd();
    glBegin(GL_QUADS); glVertex2f(0.1f, -0.75f); glVertex2f(0.15f, -0.75f); glVertex2f(0.15f, -0.99f); glVertex2f(0.1f, -0.99f); glEnd(); // legs
