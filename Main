void scene2() {


    //drawWall
    glDisable(GL_TEXTURE_2D);
    glColor3f(0.78f, 0.68f, 0.55f);
    glBegin(GL_QUADS);
    glVertex2f(-1.0f, -0.2f);
    glVertex2f(1.0f, -0.2f);
    glVertex2f(1.0f, 1.0f);
    glVertex2f(-1.0f, 1.0f);
    glEnd();

    //draw Background People
    for (int i = 0; i < 15; i++) {
        float x = -0.9f + (i * 0.13f);
        float y = -0.08f - (i % 3) * 0.04f;
        float shade = 0.4f + (i % 5) * 0.1f;
        glColor3f(shade, shade, shade);

        //head
        glBegin(GL_POLYGON);
        for (int j = 0; j < 20; j++) {
            float theta = 2.0f * 3.14159f * j / 20;
            glVertex2f(x + 0.04f * cos(theta), y + 0.15f + 0.04f * sin(theta));
        }
        glEnd();

        //body
        glBegin(GL_POLYGON);
        glVertex2f(x - 0.06f, y - 0.1f);
        glVertex2f(x + 0.06f, y - 0.1f);
        glVertex2f(x + 0.04f, y + 0.1f);
        glVertex2f(x - 0.04f, y + 0.1f);
        glEnd();
    }

    // drawShelf
    glEnable(GL_TEXTURE_2D);
    glBindTexture(GL_TEXTURE_2D, myTexture7);
    glTexEnvf(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_REPLACE);
    glBegin(GL_QUADS);
    glTexCoord2f(0.0f, 0.0f); glVertex2f(-0.8f, 0.6f);
    glTexCoord2f(1.0f, 0.0f); glVertex2f(0.8f, 0.6f);
    glTexCoord2f(1.0f, 1.0f); glVertex2f(0.8f, 0.7f);
    glTexCoord2f(0.0f, 1.0f); glVertex2f(-0.8f, 0.7f);
    glEnd();


    glDisable(GL_TEXTURE_2D);

    //Books on shelf
    //blue book
    glColor3f(0.2f, 0.7f, 0.8f);
    glBegin(GL_QUADS);
    glVertex2f(-0.75f, 0.7f); glVertex2f(-0.65f, 0.7f);
    glVertex2f(-0.65f, 0.95f); glVertex2f(-0.75f, 0.95f);
    glEnd();
    //red book
    glColor3f(0.8f, 0.3f, 0.3f);
    glBegin(GL_QUADS);
    glVertex2f(0.45f, 0.72f); glVertex2f(0.75f, 0.72f);
    glVertex2f(0.75f, 0.80f); glVertex2f(0.45f, 0.80f);
    glEnd();
    //green book
    glColor3f(0.3f, 0.8f, 0.4f);
    glBegin(GL_QUADS);
    glVertex2f(0.45f, 0.80f); glVertex2f(0.75f, 0.80f);
    glVertex2f(0.75f, 0.88f); glVertex2f(0.45f, 0.88f);
    glEnd();

    //Door
    glEnable(GL_TEXTURE_2D);
    glBindTexture(GL_TEXTURE_2D, myTexture7);
    glTexEnvf(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_REPLACE);
    glBegin(GL_QUADS);
    glTexCoord2f(0.0f, 0.0f); glVertex2f(-1.0f, -0.2f);
    glTexCoord2f(1.0f, 0.0f); glVertex2f(-0.7f, -0.2f);
    glTexCoord2f(1.0f, 1.0f); glVertex2f(-0.7f, 0.4f);
    glTexCoord2f(0.0f, 1.0f); glVertex2f(-1.0f, 0.4f);
    glEnd();
    glDisable(GL_TEXTURE_2D);
    //door handle
    glColor3f(0.9f, 0.8f, 0.1f);
    glBegin(GL_QUADS);
    glVertex2f(-0.75f, 0.05f); glVertex2f(-0.73f, 0.05f);
    glVertex2f(-0.73f, 0.08f); glVertex2f(-0.75f, 0.08f);
    glEnd();

    //Floor
    glEnable(GL_TEXTURE_2D);
    glBindTexture(GL_TEXTURE_2D, myTexture6); //texture for the prayer mat
    glTexEnvf(GL_TEXTURE_ENV, GL_TEXTURE_ENV_MODE, GL_REPLACE);
    int tiles = 6;
    float tileWidth = 2.0f / tiles;
    for (int i = 0; i < tiles; i++) {
        float x1 = -1.0f + i * tileWidth;
        float x2 = x1 + tileWidth;
        glBegin(GL_QUADS);
        glTexCoord2f(0.0f, 0.0f); glVertex2f(x1, -1.0f);
        glTexCoord2f(1.0f, 0.0f); glVertex2f(x2, -1.0f);
        glTexCoord2f(1.0f, 1.0f); glVertex2f(x2, -0.2f);
        glTexCoord2f(0.0f, 1.0f); glVertex2f(x1, -0.2f);
        glEnd();
    }
    glDisable(GL_TEXTURE_2D);

    // (Mother - Scene 2 Style)
    glPushMatrix();
